# ─── Required in production ────────────────────────────────────
NODE_ENV=development

# Convex — from `bunx convex dev` output
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Web app origin (used by API CORS + CSP connect-src)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex Auth site URL (used by auth.config.ts)
SITE_URL=http://localhost:3000

# Auth — optional external OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe — required for the webhook handler
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Elysia gateway
API_BEARER_TOKEN=
API_PORT=3001

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Redis (BullMQ worker)
REDIS_URL=redis://localhost:6379

# ─── Optional ──────────────────────────────────────────────────
WEBHOOK_TOLERANCE_SECONDS=300
LOG_LEVEL=info

# ⚠️ NEVER commit a real .env file. For Convex secrets, use
#    `bunx convex env set <NAME> <VALUE>` — they live in the Convex
#    dashboard, not in this file.
